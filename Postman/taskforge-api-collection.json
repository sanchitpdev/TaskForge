{
  "info": {
    "name": "TaskForge API",
    "description": "Complete test collection for the TaskForge Task Management System.\n\n**How to use:**\n1. Set the `baseUrl` variable if your port differs (default: http://localhost:8080)\n2. Run **Admin Login** or **User Login** first — the token is saved automatically to `adminToken` / `userToken`\n3. All secured requests pick up the token automatically via the collection-level Auth header",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8080", "type": "string" },
    { "key": "adminToken", "value": "",                      "type": "string" },
    { "key": "userToken",  "value": "",                      "type": "string" },
    { "key": "userId",     "value": "",                      "type": "string" },
    { "key": "taskId",     "value": "",                      "type": "string" }
  ],

  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
  },

  "item": [

    {
      "name": "🔐 Auth",
      "item": [

        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('adminToken', res.accessToken);",
                  "    console.log('✅ Admin token saved');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has accessToken', () => pm.expect(res.accessToken).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@example.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },

        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('userToken', res.accessToken);",
                  "    console.log('✅ User token saved');",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has accessToken', () => pm.expect(res.accessToken).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },

        {
          "name": "Login - Invalid Credentials (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
